{
  "name": "timetracker-desktop",
  "productName": "Timetracker Desktop",
  "version": "0.1.0",
  "description": "Desktop screenshot tracker for the Timetracker web app",
  "main": "main/main.js",
  "author": {
    "name": "Spark"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --x64",
    "rebuild": "electron-rebuild -f -w better-sqlite3,uiohook-napi"
  },
  "dependencies": {
    "active-win": "^8.2.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.0",
    "screenshot-desktop": "^1.15.0",
    "uiohook-napi": "^1.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.spark.timetracker.desktop",
    "productName": "Timetracker Desktop",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
